# Copy this file to .env and set your Anthropic API key before running the live vertical slice.
ANTHROPIC_API_KEY=

# The live slice refuses to call a hosted model unless this explicit switch is set to 1.
MEMORY_WEAVE_LIVE=0

# This is optional, but it makes the serving-model choice reproducible in the findings note.
MEMORY_WEAVE_VERTICAL_SLICE_MODEL=
