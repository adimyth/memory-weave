# Copy this file to .env and configure exactly one hosted-model provider before running the live vertical slice.
# Supported providers are anthropic, openai, and openrouter.

# The live slice refuses to call a hosted model unless this explicit switch is set to 1.
RETOLD_LIVE=0
RETOLD_VERTICAL_SLICE_PROVIDER=anthropic
# Anthropic uses the historical default when this is blank. OpenAI and OpenRouter require a model id or slug.
RETOLD_VERTICAL_SLICE_MODEL=

ANTHROPIC_API_KEY=

OPENAI_API_KEY=

# Optional OpenRouter host pin and attribution. OPENROUTER_PROVIDER is a comma-separated list of slugs such as deepinfra,modal; when set, fallbacks outside that list are disabled.
OPENROUTER_API_KEY=
OPENROUTER_PROVIDER=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=
