#!/usr/bin/env sh

commit_message_file="$1"
subject=$(sed -n '1p' "$commit_message_file")
pattern='^[a-z][a-z0-9-]*(\([a-z0-9][a-z0-9._/-]*\))?!?: .+$'

if printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

printf '%s\n' "Commit message must follow Conventional Commits:" >&2
printf '%s\n' "  <type>[optional scope][!]: <description>" >&2
printf '%s\n' "Example: docs(memory): clarify retrieval policy" >&2
exit 1
